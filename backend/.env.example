# ==================================================================
# OMNI — backend environment configuration
# Copy to `.env` (backend reads process env at runtime). In dev, the
# defaults in src/config/env.js are used when these are not set.
# ==================================================================

# ---- Server -------------------------------------------------------
NODE_ENV=development
PORT=3001
API_PREFIX=/api
CORS_ORIGIN=*

# ---- Auth (JWT) ---------------------------------------------------
# IMPORTANT: set a long random value in production
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-in-production-please
JWT_EXPIRES_IN=1h
REFRESH_EXPIRES_IN=30d

# ---- Data mode ----------------------------------------------------
# When true, every service returns realistic mock data (no external
# calls). Set to false once real integrations are wired up.
# When false + real API keys are set, OMNI uses real AI analysis.
MOCK_DATA=true

# ---- Database (PostgreSQL) ----------------------------------------
# For Vercel: use Vercel Postgres or Neon/Supabase connection string
# DATABASE_URL=postgresql://user:pass@host:5432/omni_db

# ---- Redis (optional) ---------------------------------------------
# REDIS_URL=redis://default:pass@host:6379

# ---- AI Services --------------------------------------------------
# OpenAI: Powers Neural Product Scan, caption generation, persona gen
# Get key: https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Anthropic: Alternative AI provider (optional)
ANTHROPIC_API_KEY=

# Stability AI: Image generation for Reality Studio (Phase 3)
STABILITY_API_KEY=

# ElevenLabs: Voiceover synthesis for Reality Studio (Phase 3)
ELEVENLABS_API_KEY=

# ---- Payment (Stripe) ---------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ---- Ad Platforms -------------------------------------------------
META_ACCESS_TOKEN=
META_APP_ID=
META_APP_SECRET=
TIKTOK_ACCESS_TOKEN=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_DEVELOPER_TOKEN=

# ---- E-commerce ---------------------------------------------------
SHOPIFY_STORE_DOMAIN=
SHOPIFY_ACCESS_TOKEN=

# ---- Email --------------------------------------------------------
SENDGRID_API_KEY=
EMAIL_FROM=noreply@omni.ai

# ---- Storage (S3/R2) ----------------------------------------------
S3_BUCKET=
S3_REGION=us-east-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
