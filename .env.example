# ==================================================================
# OMNI — Root environment configuration
# Copy to `.env` at the project root.
# ==================================================================

# Backend URL (for frontend API calls)
# In production: https://your-app.vercel.app/api
# In development: http://localhost:3001/api
API_BASE_URL=http://localhost:3001/api

# Frontend dev server port
PORT=3000

# Set to true to enable CORS for local development
DEV_MODE=true
